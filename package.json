{
  "name": "sidra",
  "productName": "Hydra",
  "version": "1.1.2-hydra.2",
  "description": "An elegant Apple Music desktop client for Linux, macOS and Windows. No frippery, just quality. A better class of Cider 🍎",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node scripts/inject-lastfm-credentials.cjs",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": {
    "name": "samueldervishii",
    "url": "https://github.com/samueldervishii"
  },
  "homepage": "https://github.com/samueldervishii/sidra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samueldervishii/sidra.git"
  },
  "bugs": {
    "url": "https://github.com/samueldervishii/sidra/issues"
  },
  "license": "BlueOak-1.0.0",
  "type": "commonjs",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.16.1",
    "typescript": "^7.x",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@holusion/dbus-next": "^0.11.2",
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.x"
  },
  "overrides": {
    "brace-expansion": ">=5.0.6",
    "undici": "7.29.0"
  },
  "build": {
    "appId": "world.wimpys.sidra",
    "copyright": "Copyright (c) Martin Wimpress",
    "publish": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/icons/**",
      "assets/lastfm-credentials.json",
      "assets/locales/about.json",
      "assets/locales/loading.json",
      "assets/locales/tray.json",
      "assets/musicKitHook.js",
      "assets/navigationBar.js",
      "assets/performanceMode.css",
      "assets/settings.html",
      "assets/settings.css",
      "assets/sidebar.css",
      "assets/settings.js",
      "assets/about.html",
      "assets/authFrameFix.js",
      "assets/authStyleFix.css",
      "assets/sidra-logo.png",
      "assets/splash.html",
      "assets/styleFix.css",
      "assets/windowChrome.css"
    ],
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/source/**"
    ],
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap"
      ],
      "category": "Audio",
      "executableName": "sidra",
      "desktop": {
        "entry": {
          "Actions": "PlayPause;Next;Previous;Stop;",
          "MimeType": "x-scheme-handler/itms;"
        },
        "desktopActions": {
          "PlayPause": {
            "Name": "Play-Pause",
            "Name[de]": "Abspielen-Pausieren",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.sidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause"
          },
          "Next": {
            "Name": "Next",
            "Name[de]": "Nächstes",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.sidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next"
          },
          "Previous": {
            "Name": "Previous",
            "Name[de]": "Vorheriges",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.sidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous"
          },
          "Stop": {
            "Name": "Stop",
            "Name[de]": "Stop",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.sidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Stop"
          }
        }
      }
    },
    "protocols": [
      {
        "name": "Apple Music URL",
        "schemes": [
          "itms"
        ]
      }
    ],
    "appImage": {
      "artifactName": "${productName}-${os}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "samueldervishii (https://github.com/samueldervishii)",
      "priority": "optional"
    },
    "rpm": {
      "vendor": "samueldervishii"
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "confinement": "strict",
        "grade": "stable",
        "summary": "An elegant Apple Music desktop client",
        "plugs": [
          "default",
          "browser-support",
          "removable-media"
        ],
        "slots": [
          {
            "mpris": {
              "name": "sidra"
            }
          }
        ],
        "environment": {
          "TMPDIR": "$XDG_RUNTIME_DIR"
        },
        "publish": false
      }
    },
    "afterPack": "build/afterPack.cjs",
    "afterSign": "build/afterSign.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 140,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
