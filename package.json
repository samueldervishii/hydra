{
  "name": "hydra",
  "productName": "Hydra",
  "desktopName": "hydra.desktop",
  "version": "2.7.0",
  "description": "Apple Music desktop client for Linux",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": {
    "name": "samueldervishii",
    "url": "https://github.com/samueldervishii"
  },
  "homepage": "https://github.com/samueldervishii/hydra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samueldervishii/hydra.git"
  },
  "bugs": {
    "url": "https://github.com/samueldervishii/hydra/issues"
  },
  "license": "BlueOak-1.0.0",
  "type": "commonjs",
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.16.1",
    "typescript": "^7.x",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@holusion/dbus-next": "^0.11.2",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.x"
  },
  "overrides": {
    "brace-expansion": ">=5.0.6",
    "undici": "7.29.1"
  },
  "build": {
    "appId": "io.github.samueldervishii.hydra",
    "copyright": "© 2026 Samuel Dervishi. Based on Sidra © Martin Wimpress.",
    "publish": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/icons/**",
      "assets/locales/about.json",
      "assets/locales/loading.json",
      "assets/locales/tray.json",
      "assets/musicKitHook.js",
      "assets/navigationBar.js",
      "assets/songSearch.js",
      "assets/vibe.js",
      "assets/vibe.css",
      "assets/playlistSort.js",
      "assets/playlistSort.css",
      "assets/topBar.js",
      "assets/topBar.css",
      "assets/performanceMode.css",
      "assets/settings.html",
      "assets/settings.css",
      "assets/settings.js",
      "assets/about.html",
      "assets/about.js",
      "assets/authFrameFix.js",
      "assets/authStyleFix.css",
      "assets/hydra-logo.png",
      "assets/hydra-splash.png",
      "assets/splash.html",
      "assets/styleFix.css",
      "assets/windowChrome.css"
    ],
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/source/**",
      "!assets/branding/**"
    ],
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "snap"
      ],
      "category": "Audio",
      "executableName": "hydra-music",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Actions": "PlayPause;Next;Previous;Stop;",
          "StartupWMClass": "hydra",
          "MimeType": "x-scheme-handler/itms;"
        },
        "desktopActions": {
          "PlayPause": {
            "Name": "Play-Pause",
            "Name[de]": "Abspielen-Pausieren",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.hydra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause"
          },
          "Next": {
            "Name": "Next",
            "Name[de]": "Nächstes",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.hydra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next"
          },
          "Previous": {
            "Name": "Previous",
            "Name[de]": "Vorheriges",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.hydra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous"
          },
          "Stop": {
            "Name": "Stop",
            "Name[de]": "Stop",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.hydra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Stop"
          }
        }
      }
    },
    "protocols": [
      {
        "name": "Apple Music URL",
        "schemes": [
          "itms"
        ]
      }
    ],
    "appImage": {
      "artifactName": "${productName}-${os}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "samueldervishii (https://github.com/samueldervishii)",
      "priority": "optional",
      "packageName": "hydra-music",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2"
      ],
      "afterRemove": "build/linux/after-remove.tpl",
      "fpm": [
        "--before-remove",
        "build/linux/before-remove.sh",
        "--conflicts",
        "sidra",
        "--replaces",
        "sidra",
        "--provides",
        "sidra",
        "--deb-field",
        "Breaks: hydra (<= 2.0.1)",
        "--replaces",
        "hydra (<= 2.0.1)"
      ]
    },
    "rpm": {
      "vendor": "samueldervishii"
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "confinement": "strict",
        "grade": "stable",
        "summary": "An elegant Apple Music desktop client",
        "plugs": [
          "default",
          "browser-support",
          "removable-media"
        ],
        "slots": [
          {
            "mpris": {
              "name": "hydra"
            }
          }
        ],
        "environment": {
          "TMPDIR": "$XDG_RUNTIME_DIR"
        },
        "publish": false
      }
    },
    "afterPack": "build/afterPack.cjs",
    "afterSign": "build/afterSign.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 140,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
